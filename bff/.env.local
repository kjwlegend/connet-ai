MAX_FILE_SIZE_MB=50

# Task Queue (ARQ)
REDIS_QUEUE_URL="redis://localhost:6379/1"
WORKER_CONCURRENCY=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Monitoring & Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=""

# External Service URLs
FRONTEND_URL="http://localhost:3000"
