REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "https://app.connet.ai"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
