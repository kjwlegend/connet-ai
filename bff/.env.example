# Application Configuration
APP_NAME="Connet.AI BFF Service"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# Database Configuration (Supabase)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""  # PostgreSQL connection string

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""
REDIS_DB=0

# Authentication & Security
SECRET_KEY=""  # Generate with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_urlsafe(32))"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,https://app.connet.ai"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="*"

# AI Service Configuration
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_DEFAULT_MODEL="gpt-3.5-turbo"
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=""
LANGCHAIN_API_KEY=""
LANGSMITH_API_KEY=""

# Vector Database
VECTOR_DIMENSION=1536  # OpenAI ada-002 embedding dimension

# File Storage (Supabase Storage)
STORAGE_BUCKET_NAME="connet-files"
MAX_FILE_SIZE_MB=50

# Task Queue (ARQ)
REDIS_QUEUE_URL="redis://localhost:6379/1"
WORKER_CONCURRENCY=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Monitoring & Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=""

# External Service URLs
FRONTEND_URL="http://localhost:3000"
WEBHOOK_SECRET=""

# Development Settings
PYTEST_ASYNCIO_MODE="auto"
TEST_DATABASE_URL=""

# Production Settings (set in production environment)
# SENTRY_DSN=""
# OTEL_EXPORTER_OTLP_ENDPOINT=""
# PROMETHEUS_PUSHGATEWAY_URL=""