# Application Configuration
APP_NAME="Connet.AI BFF Service"
APP_VERSION="0.1.0"
APP_ENV="staging"
DEBUG=false
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8080
RELOAD=false

# Database Configuration (Supabase)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# Redis Configuration
REDIS_URL="redis://localhost:6379/2"
REDIS_PASSWORD=""
REDIS_DB=2

# Authentication & Security
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3

# CORS Configuration
CORS_ORIGINS="https://uat.connet.ai"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="*"

# AI Service Configuration
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_DEFAULT_MODEL="gpt-4o"
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=""
LANGCHAIN_API_KEY=""
LANGSMITH_API_KEY=""

# Vector Database
VECTOR_DIMENSION=1536

# File Storage (Supabase Storage)
STORAGE_BUCKET_NAME="connet-files-uat"
MAX_FILE_SIZE_MB=50

# Task Queue (ARQ)
REDIS_QUEUE_URL="redis://localhost:6379/5"
WORKER_CONCURRENCY=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20

# Monitoring & Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=""

# External Service URLs
FRONTEND_URL="https://app-uat.connet.ai"
WEBHOOK_SECRET=""

# Production Settings (set as needed)
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
PROMETHEUS_PUSHGATEWAY_URL=""
